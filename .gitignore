# ============ Unity 生成目录（不要提交） ============
/ECS-Test/[Ll]ibrary/
/ECS-Test/[Tt]emp/
/ECS-Test/[Oo]bj/
/ECS-Test/[Bb]uild/
/ECS-Test/[Bb]uilds/
/ECS-Test/[Ll]ogs/
/ECS-Test/[Uu]ser[Ss]ettings/
/ECS-Test/[Mm]emoryCaptures/
/ECS-Test/[Rr]ecordings/

# ============ 性能分析产物（体积巨大，不进版本库） ============
# Profiler / Profile Analyzer 保存的数据文件
*.pdata
*.snap
*.raw
# Profile Analyzer 的临时目录
/ECS-Test/[Pp]rofile[Aa]nalyzer/
# 手动保存的性能分析数据
/ECS-Test/[Aa]ssets/Resource/Profile/

# ============ Unity 自动生成的 C# 工程文件 ============
# 由编辑器每次打开时重新生成，不需要提交
/ECS-Test/*.csproj
/ECS-Test/*.sln
/ECS-Test/*.user

# ============ 构建产物 ============
*.apk
*.aab
*.unitypackage
*.crashreport
crashlytics-build.properties
sysinfo.txt

# ============ IDE / 编辑器 ============
.vs/
.idea/
.vscode/
*.suo
*.userprefs
*.pidb
*.pidb.meta
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.booproj
*.svd

# ============ 系统文件 ============
.DS_Store
Thumbs.db
Desktop.ini

# ============ Asset Store 工具缓存 ============
/ECS-Test/[Aa]ssets/AssetStoreTools*
